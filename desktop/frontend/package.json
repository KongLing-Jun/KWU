{
  "name": "kwu-desktop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wails": "pnpm dev",
    "build": "node scripts/check-css-syntax.mjs && node scripts/check-z-index-tokens.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:css": "node scripts/check-css-syntax.mjs && node scripts/check-z-index-tokens.mjs",
    "test:todo-visibility": "node scripts/test-todo-visibility.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-todo-visibility.mjs && node scripts/run-tests.mjs",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:all": "tsc --noEmit -p tsconfig.test.json && node scripts/test-todo-visibility.mjs && node scripts/run-tests.mjs",
    "test:vitest": "tsc --noEmit -p tsconfig.vitest.json && vitest run --config vitest.config.ts",
    "test:vitest:coverage": "tsc --noEmit -p tsconfig.vitest.json && vitest run --config vitest.config.ts --coverage",
    "test:browser": "tsc --noEmit -p tsconfig.playwright.json && playwright test --config playwright.config.ts",
    "test:browser:runtime": "tsc --noEmit -p tsconfig.playwright.json && playwright test --config playwright.runtime.config.ts --grep-invert @audit",
    "test:browser:audit": "tsc --noEmit -p tsconfig.playwright.json && playwright test --config playwright.runtime.config.ts --grep @audit",
    "test:browser:update": "playwright test --config playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@lobehub/icons-static-svg": "1.95.1",
    "@tanstack/react-virtual": "^3.14.13",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^29.1.1",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0"
  }
}
